    {
      "parameters": {
        "jsCode": "// Read ALL items from the sheet\nconst allItems = $input.all();\n\n// Keep ONLY rows where Status is exactly 'Ready'\nconst readyItems = allItems.filter(item =>\n  (item.json['Status'] || '').trim() === 'Ready'\n);\n\n// Nothing ready \u2014 return a sentinel so IF_Has_Ready_Post routes to the Telegram alert\nif (readyItems.length === 0) {\n  return [{ json: { 'Row ID': '', 'Content Idea': '', '_no_ready': true } }];\n}\n\n// \u2705 Return ONLY the FIRST ready row \u2014 one post per hourly run\nreturn [readyItems[0]];"
      },
      "id": "pick-ready-001",
      "name": "Filter_Pick_First_Ready_Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        208
      ],
      "notes": "FIX: Filters all rows for Status=Ready then picks only item[0]. Prevents row-1 repeat bug."
    },
